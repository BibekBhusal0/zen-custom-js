  {
    "property": "extension.browse-bot.findbar-ai.enabled",
    "label": "Enable Findbar AI",
    "type": "checkbox",
    "defaultValue": true,
    "description": "Globally enables or disables the AI-powered findbar."
  },
  {
    "property": "extension.browse-bot.urlbar-ai-enabled",
    "label": "Enable URLBar AI",
    "type": "checkbox",
    "defaultValue": true,
    "description": "Enables or disables the AI features in the URL bar."
  },
  {
    "property": "extension.browse-bot.urlbar-ai.hide-suggestions",
    "label": "Hide Suggestions in URLBar AI",
    "type": "checkbox",
    "defaultValue": true,
    "description": "Hides the autocomplete suggestions when URLBar AI is active.",
    "conditions": [
      {
        "if": {
          "property": "extension.browse-bot.urlbar-ai-enabled",
          "value": true
        }
      }
    ]
  },
  {
    "property": "extension.browse-bot.urlbar-ai.animations-enabled",
    "label": "Enable Animations in URLBar AI",
    "type": "checkbox",
    "defaultValue": true,
    "description": "Enables animations for the URLBar AI interface.",
    "conditions": [
      {
        "if": {
          "property": "extension.browse-bot.urlbar-ai-enabled",
          "value": true
        }
      }
    ]
  },
  {
    "property": "extension.browse-bot.library-ai.enabled",
    "label": "Enable Library AI",
    "type": "checkbox",
    "defaultValue": true,
    "description": "Adds a BrowseBot section to the Zen Library with chat, agent, and build modes."
  },
  {
    "property": "extension.browse-bot.library-ai.mode",
    "label": "Library AI Mode",
    "type": "dropdown",
    "defaultValue": "chat",
    "description": "Chat has no tools or page context. Agent has the full browser tool-belt. Build styles the browser chrome live and ships Sine mods.",
