    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "zen-command-palette.dynamic.workspaces",
    "label": "Enable Workspace commands",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "property": "zen-command-palette.dynamic.folders",
    "label": "Enable Folder Management commands",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "zen-command-palette.dynamic.sine-mods",
    "label": "Enable Sine Mod Management commands",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "zen-command-palette.dynamic.container-tabs",
    "label": "Enable Container Tab commands",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "property": "zen-command-palette.dynamic.active-tabs",
    "label": "Enable Active Tab switching commands",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "property": "zen-command-palette.dynamic.unload-tab",
    "label": "Enable Active Tab unloading commands",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "property": "zen-command-palette.dynamic.extension-enable-disable",
    "label": "Enable Extension Enable/Disable commands",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "property": "zen-command-palette.dynamic.extension-uninstall",
    "label": "Enable Extension Uninstall commands",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "property": "zen-command-palette.dynamic.profiles",
    "label": "Enable Profile switching commands",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "property": "zen-command-palette.dynamic.about-pages",
    "label": "Enable `about:` page commands",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "property": "zen-command-palette.dynamic.quick-split",
    "label": "Enable Quick Split (split view and glance from the palette)",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Quick Split",
    "margin": "25px 0 15px 0"
  },
  {
    "type": "text",
    "label": "Type `site1 | site2` for side-by-side, `site1 - site2` for stacked, mixing both for grid, or `+site` for glance in the palette. A leading/trailing separator uses the current tab (e.g. `| gh`). `-` and `_` need spaces around them. Manage keywords in the palette settings, in the Quick Split section."
  },
  {
    "type": "string",
    "property": "zen-command-palette.quick-split.search-engine",
    "label": "Search Engine",
    "placeholder": "Empty for DuckDuckGo Lucky",
    "defaultValue": "",
    "description": "Empty means DuckDuckGo Lucky, Google Lucky means Google Lucky. Both jump to the first result."
  },
  {
    "type": "separator",
    "label": "Development",
    "margin": "25px 0 15px 0"
  },
  {
    "type": "checkbox",
    "property": "zen-command-palette.debug-mode",
    "label": "Enable debug logging in Browser Console",
    "defaultValue": false
  },
  {
    "type": "text",
    "label": "",
    "margin": "30px 0 0 0"
  },
  {
    "type": "text",
    "label": "**Compact Settings**",
    "size": "18px",
    "margin": "20px 0 10px 0"
  },
  {
    "property": "compact-settings.enabled",
    "label": "Compact Settings",
    "type": "checkbox",
    "defaultValue": true
